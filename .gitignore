*.swo
.DS_Store

# Local settings overlay (enables paper trading on this machine; never commit)
config/settings.local.yaml
config/settings.local.yaml.bak.*

# Local data / runtime artifacts (do not commit broker data)
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-shm
data/*.sqlite-wal
data/*.jsonl
logs/
*.log
# 13G Strategy Lab UI (explicit; logs/ is already ignored)
logs/strategy-lab-ui.stdout.log
logs/strategy-lab-ui.stderr.log
data/runtime/strategy_lab_ui.pid

# Local Strategy Lab UI runtime / auto-paper loop state (machine-specific, never commit)
data/runtime/
data/auto_paper_loop/
# Prompt 13M: paper daily/weekly reports (file outputs; never commit)
data/reports/

# Generated daily research / scan / chart / journal artifacts.
# Source code creates them on demand; .gitkeep sentinels keep dirs in tree.
data/debug_charts/*
!data/debug_charts/.gitkeep
data/mtf_smc/*
!data/mtf_smc/.gitkeep
data/smc_setups/*
!data/smc_setups/.gitkeep
data/pre_open_news/*
!data/pre_open_news/.gitkeep
data/research/
data/strategies/
data/watchlists/
data/market_regime/
data/review_queue/
data/scheduler/
data/telegram_commands/
data/account_snapshots*
data/paper_orders/
# Prompt 13E: backtest engine reports — runtime artifacts; never commit.
data/backtests/*
!data/backtests/.gitkeep
# Prompt 13D: ICT/SMC Intraday research scan outputs (per-symbol JSON +
# watchlist summary). Generated on demand by ``scan-intraday-smc[_watchlist]``.
data/intraday_smc/*
!data/intraday_smc/.gitkeep
# Prompt 13E: candle cache used by the backtest engine. Populated on
# demand by ``python -m bot.cli fetch-candles`` (read-only IBKR fetch).
# Never committed; contains historical broker data.
data/candles/*
!data/candles/.gitkeep
# Prompt 13L-alt: per-ticker edge profiles (backtest-derived; never commit).
data/edge_profiles/*
!data/edge_profiles/.gitkeep

# UI server scratch (sessions, sqlite caches, etc.)
bot_ui/.cache/
bot_ui/__pycache__/
.uvicorn.pid

# Memory rolling files (do not leak personal trade / research data)
memory/DAILY-SUMMARY.md
memory/RESEARCH-REPORT.md
memory/PAPER-DAILY-REPORT.md
memory/PAPER-WEEKLY-REPORT.md
memory/NEWS-REPORT.md
memory/SMC-REVIEW-QUEUE.md

# Jupyter
.ipynb_checkpoints/
