# =============================================================================
# Local development environment example.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This bot is paper-only; live trading is intentionally NOT supported here.
# =============================================================================

# -----------------------------------------------------------------------------
# Interactive Brokers TWS / IB Gateway (Worker process only)
# -----------------------------------------------------------------------------
# 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper, 4001 = IB Gateway live
# IBKR_ACCOUNT_MODE MUST stay "paper" for this project. Live mode is rejected by safety checks.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_MODE=paper

# -----------------------------------------------------------------------------
# Telegram notifications (optional; bot degrades gracefully if missing)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Perplexity (used by research module; optional)
# -----------------------------------------------------------------------------
PERPLEXITY_API_KEY=

# =============================================================================
# Local Strategy Lab UI (bot_ui)
# =============================================================================
# The local UI runs at http://127.0.0.1:8765 by default and never touches IBKR
# at startup. It only reads files / runs allowlisted CLI commands.
STRATEGY_LAB_HOST=127.0.0.1
STRATEGY_LAB_PORT=8765

# Backend mode the UI talks to.
#   local    -> read project files, run local CLI subprocess (default, paper only)
#   remote   -> placeholder for future Vercel UI -> Worker via DB queue (NOT IMPLEMENTED YET)
STRATEGY_LAB_BACKEND=local

# =============================================================================
# Future remote deployment (Vercel UI + Worker + Database). NOT USED LOCALLY.
# These keys are placeholders so the architecture stays Vercel-ready.
# Leave blank for local development.
# =============================================================================
# Postgres / Supabase connection used by the future RemoteCommandQueue + DatabaseStateStore.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between Vercel UI and Worker (HMAC for command queue auth).
WORKER_SHARED_SECRET=

# Public URL of the worker REST endpoint (for status polling from UI).
WORKER_PUBLIC_URL=
