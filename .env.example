# Interactive Brokers TWS / IB Gateway
# 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper, 4001 = IB Gateway live
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_MODE=paper

# Telegram notifications (optional; bot degrades gracefully if missing)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Perplexity (used later for research; not required for foundation milestone)
PERPLEXITY_API_KEY=
